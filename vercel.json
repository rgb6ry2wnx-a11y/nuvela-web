{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/almohadas/almohada-de-plumas",
      "destination": "/almohadas/alessandra",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "nuvelagt.com"
        }
      ],
      "destination": "https://www.nuvelagt.com/:path*",
      "statusCode": 301
    }
  ]
}
